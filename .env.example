# Copy this file to .env and uncomment exactly ONE option.
# Check it with:  python check_key.py

# --- Option A: GitHub Models (free, works from Hong Kong, needs only a GitHub account)
# 1. github.com -> Settings -> Developer settings -> Personal access tokens -> Fine-grained
# 2. Permissions: Account permissions -> Models -> Read-only
# 3. Paste the token below. Free tier is roughly 50-150 requests/day.
LLM_API_KEY=github_pat_xxxxxxxxxxxx
LLM_BASE_URL=https://models.github.ai/inference
LLM_MODEL=openai/gpt-4o-mini

# --- Option B: Google Gemini (free tier, NOT available in Hong Kong / Macao / mainland China)
# LLM_API_KEY=AIza-your-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Option C: OpenRouter (one key, many models; ":free" models are 50 requests/day)
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# --- Option D: DeepSeek (cheapest paid option, ~1 RMB per million tokens)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- Option E: OpenAI
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
