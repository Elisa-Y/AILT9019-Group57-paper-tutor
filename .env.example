# Copy this file to .env and uncomment exactly ONE option.
# Check it with:  python check_key.py

# --- Option A: Groq (free, no credit card, works from Hong Kong) --------------
# console.groq.com -> sign in with Google/GitHub -> API Keys -> Create API Key
# Free plan: ~30 requests/min, ~1,000 requests/day per model. Fast.
LLM_API_KEY=gsk_xxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# other free models: openai/gpt-oss-20b · qwen/qwen3.8-27b (check console.groq.com/settings/limits)

# --- Option B: OpenRouter (one key, many models, ":free" models are ~50/day) --
# openrouter.ai -> Keys -> Create key
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemini-2.5-flash

# --- Option C: DeepSeek (no daily cap, ~1 RMB per million tokens, needs top-up)
# platform.deepseek.com
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# --- Option D: Google Gemini (NOT available in Hong Kong / Macao / mainland China)
# LLM_API_KEY=AIza-your-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Option E: OpenAI ---------------------------------------------------------
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# NOTE: GitHub Models was retired on 2026-07-30. `https://models.github.ai` no longer
# serves inference, so a GitHub PAT will not work here.
